export TT_BLACKSMITH_HOME=$(pwd)

EXPECTED_ARGS=1

if [ "$#" -gt "$EXPECTED_ARGS" ]; then
  echo "Single option for experiment type expected, possible options are: TT-Crank (--crank), TT-ML (--ttml), TT-XLA (--xla), TT-Forge-FE (--ffe) or GPU (--gpu)"
  return 1
fi

case $1 in
    --ffe) EXPERIMENT_TYPE=0 ;;
    --xla) EXPERIMENT_TYPE=1 ;;
    --gpu) EXPERIMENT_TYPE=2 ;;
    --crank) EXPERIMENT_TYPE=3 ;;
    --ttml) EXPERIMENT_TYPE=4 ;;
    "")
        # No argument provided, default to TT-Crank
        echo "No type of experiment was specified, possible options are: TT-Crank (--crank), TT-ML (--ttml), TT-XLA (--xla), TT-Forge-FE (--ffe) or GPU (--gpu)"
        echo "Defaulting to TT-Crank (--crank)"
        EXPERIMENT_TYPE=3
        ;;
    *) echo "Unknown parameter passed: $1"; return 1 ;;
esac

# pytest alias for venv interpreter
alias pytest='python -m pytest'

# Set environment directory based on experiment type
case $EXPERIMENT_TYPE in
    0)
        export TT_BLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/ffe_env
        ;;
    1)
        export TT_BLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/xla_env
        ;;
    2)
        export TT_BLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/gpu_env
        export PJRT_DEVICE=CUDA
        ;;
    3)
        export TT_BLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/crank_env
        ;;
    4)
        export TT_BLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/ttml_env
        ;;
    *)
        echo "Unknown experiment type: $EXPERIMENT_TYPE"
        return 1
esac

# Function to get expected package version from requirements file
# Usage: get_expected_version <package_name> <requirements_file>
get_expected_version() {
    grep -oP "${1}==\K[^\s]+" "$2" 2>/dev/null || echo ""
}

# Function to get installed package version
# Usage: get_installed_version <package_name>
get_installed_version() {
    $TT_BLACKSMITH_ENV_DIR/bin/pip show "$1" 2>/dev/null | grep -oP '^Version: \K.*' || echo ""
}

# Function to get index URLs from requirements file
# Usage: get_index_urls <requirements_file>
get_index_urls() {
    local index_url=$(grep -oP '^--index-url\s+\K\S+' "$1" 2>/dev/null)
    local extra_index_urls=$(grep -oP '^--extra-index-url\s+\K\S+' "$1" 2>/dev/null)

    local result=""
    if [ -n "$index_url" ]; then
        result="--index-url $index_url"
    fi
    for url in $extra_index_urls; do
        result="$result --extra-index-url $url"
    done
    echo "$result"
}

# Function to check package version and force reinstall if mismatch
# Usage: check_package_version <package_name> <requirements_file>
# Returns 0 if versions match or package was updated
check_package_version() {
    local package="$1"
    local requirements="$2"
    local expected=$(get_expected_version "$package" "$requirements")
    local installed=$(get_installed_version "$package")

    if [ -n "$expected" ] && [ "$expected" != "$installed" ]; then
        echo "${package} version mismatch detected!"
        echo "  Installed: ${installed:-none}"
        echo "  Expected:  $expected"
        echo "Upgrading ${package} to version ${expected}..."
        local index_urls=$(get_index_urls "$requirements")
        pip install --force-reinstall $index_urls "${package}==${expected}"
    fi
    return 0
}

# Function to install tt-crank into the active venv
# Installs the wheel from tt-mlir's nightly run (env/download_crank_wheel.sh, cached
# in env/wheels/)
install_tt_crank() {
    if python -c "import tt_crank" > /dev/null 2>&1; then
        return 0
    fi

    local wheel
    wheel=$(env/download_crank_wheel.sh) || {
        echo "Could not fetch the tt-crank wheel; log in with 'gh auth login' and retry."
        return 1
    }
    echo "Installing $wheel"
    # One resolve for the wheel and the requirement files: installed separately, pip
    # would not re-check the wheel's pins (numpy<2, click) against the later files.
    pip install "$wheel" -r env/crank_requirements.txt -r env/requirements.txt || return 1
    echo "Note: tt-crank needs the SFPI toolchain in /opt/tenstorrent/sfpi; if missing or outdated run 'tt-crank-install-sfpi' (needs sudo)."
}

# ttml (tt-train) is not pip-installable: it is the Python sources of a tt-metal checkout plus the
# _ttml extension built by `build_metal.sh --build-tt-train`, put on the path by .pth files that
# tt-metal's create_venv.sh writes. Never `pip install ttml`: that name on PyPI is an unrelated package.
TTML_REQUIREMENTS=env/ttml_requirements.txt
# The checkout an env was created against; its .pth files point there.
TTML_METAL_HOME_FILE=$TT_BLACKSMITH_ENV_DIR/tt_metal_home

pinned_tt_metal_sha() {
    grep -oP '^# tt-metal:\s*\K[0-9a-f]+' "$TTML_REQUIREMENTS"
}

ttml_extension() {
    ls "$TT_METAL_HOME"/build/tt-train/sources/ttml/_ttml*.so 2>/dev/null | head -1
}

check_tt_metal_home() {
    if [ -z "$TT_METAL_HOME" ] || [ -z "$(ttml_extension)" ]; then
        echo "ttml needs TT_METAL_HOME set to a tt-metal checkout built with tt-train, e.g.:"
        echo "  git clone https://github.com/tenstorrent/tt-metal.git && cd tt-metal"
        echo "  git checkout $(pinned_tt_metal_sha) && git submodule update --init --recursive"
        echo "  ./build_metal.sh --build-tt-train"
        echo "  export TT_METAL_HOME=\$(pwd)"
        return 1
    fi
}

# The venv interpreter must match the ABI _ttml was built for (e.g. cpython-312); an abi3 build takes any.
ttml_python_version() {
    local tag
    tag=$(basename "$(ttml_extension)" | grep -oP 'cpython-\K[0-9]+')
    if [ -z "$tag" ]; then
        echo "3.12"
    else
        echo "${tag:0:1}.${tag:1}"
    fi
}

warn_tt_metal_sha_mismatch() {
    local pinned actual
    pinned=$(pinned_tt_metal_sha)
    actual=$(git -c safe.directory="$TT_METAL_HOME" -C "$TT_METAL_HOME" rev-parse HEAD 2>/dev/null)
    if [ -n "$pinned" ] && [ "$actual" != "$pinned" ]; then
        echo "Warning: $TT_METAL_HOME is at ${actual:-an unknown commit}, $TTML_REQUIREMENTS pins $pinned"
    fi
}

# Creates (first time) or activates the ttml env.
setup_ttml_env() {
    if [ -z "$TT_METAL_HOME" ] && [ -f "$TTML_METAL_HOME_FILE" ]; then
        export TT_METAL_HOME=$(cat "$TTML_METAL_HOME_FILE")
    fi
    check_tt_metal_home || return 1
    if [ -f "$TTML_METAL_HOME_FILE" ] && [ "$(cat "$TTML_METAL_HOME_FILE")" != "$TT_METAL_HOME" ]; then
        echo "$TT_BLACKSMITH_ENV_DIR was created against $(cat "$TTML_METAL_HOME_FILE"), not $TT_METAL_HOME;"
        echo "remove it and activate again to switch checkouts"
        return 1
    fi
    # ttml utilities read the runtime root (kernel sources, data).
    export TT_METAL_RUNTIME_ROOT=$TT_METAL_HOME
    warn_tt_metal_sha_mismatch

    if [ ! -f "$TT_BLACKSMITH_ENV_DIR/bin/activate" ]; then
        echo "Creating virtual environment in $TT_BLACKSMITH_ENV_DIR from $TT_METAL_HOME"
        # tt-metal builds the venv: ttnn (editable) and its deps, plus the ttml.pth / _ttml.pth files.
        (cd "$TT_METAL_HOME" && PYTHON_ENV_DIR="$TT_BLACKSMITH_ENV_DIR" ./create_venv.sh \
            --python-version "$(ttml_python_version)") || return 1
        echo "$TT_METAL_HOME" > "$TTML_METAL_HOME_FILE"
        source $TT_BLACKSMITH_ENV_DIR/bin/activate
        # The venv comes with uv but without pip.
        uv pip install -r $TTML_REQUIREMENTS -e $TT_BLACKSMITH_HOME || return 1
    else
        source $TT_BLACKSMITH_ENV_DIR/bin/activate
    fi

    python -c "import ttml, blacksmith" || {
        echo "ttml does not import from $TT_BLACKSMITH_ENV_DIR; rebuild tt-metal with --build-tt-train or recreate the env"
        return 1
    }
}

# The ttml env is created and versioned by tt-metal, not by the requirement files below.
if [ "$EXPERIMENT_TYPE" -eq 4 ]; then
    setup_ttml_env
    return
fi

# If environment directory already exists, check versions and activate
if [ -d $TT_BLACKSMITH_ENV_DIR/bin ]; then
    if [ ! -f $TT_BLACKSMITH_ENV_DIR/bin/activate ]; then
        echo "Virtual environment directory exists but does not contain activate script,"
        echo "please remove the $TT_BLACKSMITH_ENV_DIR directory and try again"
        return
    fi

    # Activate environment
    source $TT_BLACKSMITH_ENV_DIR/bin/activate

    if [ "$EXPERIMENT_TYPE" -eq 3 ]; then
        install_tt_crank
        return
    fi

    # Only check tt-xla packages; return early for other experiment types
    if [ "$EXPERIMENT_TYPE" -ne 1 ]; then
        return
    fi

    # If a debug pjrt-plugin-tt wheel is installed, just tag the prompt
    if get_installed_version "pjrt-plugin-tt" | grep -q '+dev'; then
        return
    fi

    # Otherwise check and upgrade package if needed
    check_package_version "pjrt-plugin-tt" "env/xla_requirements.txt"
fi

# Otherwise create it
echo "Creating virtual environment in $TT_BLACKSMITH_ENV_DIR"
# Latest torch-xla CUDA 12.6 GPU wheel is not available for Python 3.12, so we need to keep the GPU environment on Python 3.11
# Also keep the FFE environment on Python 3.11
case $EXPERIMENT_TYPE in
    0|2)
        python3.11 -m venv $TT_BLACKSMITH_ENV_DIR
        ;;
    1|3)
        python3.12 -m venv $TT_BLACKSMITH_ENV_DIR
        ;;
    *)
        echo "Unknown experiment type: $EXPERIMENT_TYPE"
        return 1
esac
source $TT_BLACKSMITH_ENV_DIR/bin/activate
pip install --upgrade pip

# Install dependencies based on experiment type
case $EXPERIMENT_TYPE in
    0)
        pip install -r env/ffe_requirements.txt
        ;;
    1)
        pip install -r env/xla_requirements.txt -r env/requirements.txt
        ;;
    2)
        pip install -r env/gpu_requirements.txt -r env/requirements.txt
        ;;
    3)
        install_tt_crank || return 1
        ;;
    *)
        echo "Unknown experiment type: $EXPERIMENT_TYPE"
        return 1
esac

pip install -e $TT_BLACKSMITH_HOME
