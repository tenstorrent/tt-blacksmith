TT_BLACKSMITH_HOME=$(pwd)

tt_forge_fe=false
tt_xla=false

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --ffe) tt_forge_fe=true ;;
        --xla) tt_xla=true ;;
        *) echo "Unknown parameter passed: $1"; return 1 ;;
    esac
    shift
done

# if both are false, exit with error
if [ "$tt_forge_fe" = false ] && [ "$tt_xla" = false ]; then
    echo "Both TT-Forge-FE and TT-XLA are false, please specify one of them"
    return 1
fi

# Set environment directory based on frontend
# To be safe we have two different environment directories for each frontend
if [ "$tt_forge_fe" = true ]; then
    export TTBLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/ffe_env
fi
if [ "$tt_xla" = true ]; then
    export TTBLACKSMITH_ENV_DIR=$TT_BLACKSMITH_HOME/env/xla_env
fi

# If environment directory already exists, activate it
if [ -d $TTBLACKSMITH_ENV_DIR/bin ]; then
    [ -f $TTBLACKSMITH_ENV_DIR/bin/activate ] && source $TTBLACKSMITH_ENV_DIR/bin/activate
    exit 0
fi

# Otherwise create it
echo "Creating virtual environment in $TTBLACKSMITH_ENV_DIR"
python3.11 -m venv $TTBLACKSMITH_ENV_DIR
source $TTBLACKSMITH_ENV_DIR/bin/activate
pip install --upgrade pip

# Install dependencies based on frontend
if [ "$tt_forge_fe" = true ]; then
    pip install -r env/ffe_requirements.txt
fi
if [ "$tt_xla" = true ]; then
    pip install -r env/xla_requirements.txt
fi

# Install base dependencies
pip install -r env/requirements.txt
export TT_BLACKSMITH_FRONTEND=$TT_BLACKSMITH_FRONTEND
pip install -e $TT_BLACKSMITH_HOME
